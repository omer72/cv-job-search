# Required: OpenAI API key used for CV parsing, CV review and job match scoring.
OPENAI_API_KEY=sk-...

# Optional: override the model (default gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Optional: Serper.dev key. Without it the app still works using direct
# ATS board APIs (Greenhouse/Lever/Ashby/SmartRecruiters/Recruitee/Workable)
# and careers-page probing; with it, companies whose board is not found
# get a real web search to locate their careers page.
SERPER_API_KEY=
